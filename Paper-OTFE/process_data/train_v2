"""
FDM 端到端光谱重建网络训练
修复维度问题
"""

import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import Dataset, DataLoader
import h5py
import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path
import time


# ==================== 数据集 ====================
class FDMDataset(Dataset):
    def __init__(self, mat_file, split="train"):
        print(f"加载 {split} 数据集...")

        with h5py.File(mat_file, "r") as f:
            X = np.array(f[f"X_{split}"]).astype(np.float32)
            Y = np.array(f[f"Y_{split}"]).astype(np.float32)

        print(f"  原始 X shape: {X.shape}")
        print(f"  原始 Y shape: {Y.shape}")

        # MATLAB HDF5 保存格式是 [特征, 样本]
        # 需要转置为 [样本, 特征]
        if X.shape[0] < X.shape[1]:  # 如果第一维小，说明是 [特征, 样本]
            X = X.T
            Y = Y.T

        self.X = torch.from_numpy(X)
        self.Y = torch.from_numpy(Y)

        # 添加通道维度: [N_samples, N_points] -> [N_samples, 1, N_points]
        if self.X.dim() == 2:
            self.X = self.X.unsqueeze(1)

        print(f"  最终 X_{split}: {self.X.shape}")
        print(f"  最终 Y_{split}: {self.Y.shape}")

    def __len__(self):
        return len(self.X)

    def __getitem__(self, idx):
        return self.X[idx], self.Y[idx]


# ==================== 实测数据集 ====================
class RealDataset(Dataset):
    def __init__(self, mat_file):
        print(f"加载实测数据集...")

        with h5py.File(mat_file, "r") as f:
            X = np.array(f["X_real"]).astype(np.float32)
            Y = np.array(f["Y_real"]).astype(np.float32)

        print(f"  原始 X shape: {X.shape}")
        print(f"  原始 Y shape: {Y.shape}")

        # 转置
        if X.shape[0] < X.shape[1]:
            X = X.T
            Y = Y.T

        self.X = torch.from_numpy(X)
        self.Y = torch.from_numpy(Y)

        if self.X.dim() == 2:
            self.X = self.X.unsqueeze(1)

        print(f"  最终 X_real: {self.X.shape}")
        print(f"  最终 Y_real: {self.Y.shape}")

    def __len__(self):
        return len(self.X)

    def __getitem__(self, idx):
        return self.X[idx], self.Y[idx]


# ==================== 网络模型 ====================
class FDMNet(nn.Module):
    """1D CNN + FC 网络"""

    def __init__(self, input_length=1000, output_channels=31, dropout=0.5):
        super().__init__()

        # 1D卷积层
        self.conv = nn.Sequential(
            nn.Conv1d(1, 32, kernel_size=7, stride=2, padding=3),
            nn.BatchNorm1d(32),
            nn.ReLU(),
            nn.MaxPool1d(2),
            nn.Conv1d(32, 64, kernel_size=5, stride=2, padding=2),
            nn.BatchNorm1d(64),
            nn.ReLU(),
            nn.MaxPool1d(2),
            nn.Conv1d(64, 128, kernel_size=3, stride=2, padding=1),
            nn.BatchNorm1d(128),
            nn.ReLU(),
            nn.AdaptiveAvgPool1d(16),
        )

        # 全连接层
        self.fc = nn.Sequential(
            nn.Flatten(),
            nn.Linear(128 * 16, 256),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(256, 128),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(128, output_channels),
            nn.Sigmoid(),
        )

    def forward(self, x):
        x = self.conv(x)
        x = self.fc(x)
        return x


# ==================== 训练函数 ====================
def train_epoch(model, loader, criterion, optimizer, device):
    model.train()
    total_loss = 0
    total_rmse = 0
    n_batches = 0

    for X, Y in loader:
        X, Y = X.to(device), Y.to(device)

        optimizer.zero_grad()
        pred = model(X)
        loss = criterion(pred, Y)
        loss.backward()
        optimizer.step()

        total_loss += loss.item()
        rmse = torch.sqrt(torch.mean((pred - Y) ** 2)).item()
        total_rmse += rmse
        n_batches += 1

    avg_loss = total_loss / n_batches
    avg_rmse = total_rmse / n_batches
    avg_psnr = 20 * np.log10(1.0 / (avg_rmse + 1e-8))

    return {"loss": avg_loss, "rmse": avg_rmse, "psnr": avg_psnr}


def evaluate(model, loader, criterion, device):
    model.eval()
    total_loss = 0
    total_rmse = 0
    n_batches = 0

    with torch.no_grad():
        for X, Y in loader:
            X, Y = X.to(device), Y.to(device)
            pred = model(X)
            loss = criterion(pred, Y)

            total_loss += loss.item()
            rmse = torch.sqrt(torch.mean((pred - Y) ** 2)).item()
            total_rmse += rmse
            n_batches += 1

    avg_loss = total_loss / n_batches
    avg_rmse = total_rmse / n_batches
    avg_psnr = 20 * np.log10(1.0 / (avg_rmse + 1e-8))

    return {"loss": avg_loss, "rmse": avg_rmse, "psnr": avg_psnr}


def evaluate_detailed(model, loader, device):
    """详细评估，返回所有预测结果"""
    model.eval()
    all_preds = []
    all_targets = []

    with torch.no_grad():
        for X, Y in loader:
            X = X.to(device)
            pred = model(X)
            all_preds.append(pred.cpu().numpy())
            all_targets.append(Y.numpy())

    preds = np.concatenate(all_preds, axis=0)
    targets = np.concatenate(all_targets, axis=0)

    # 计算指标
    rmse = np.sqrt(np.mean((preds - targets) ** 2))
    mae = np.mean(np.abs(preds - targets))

    # 每个样本的RMSE
    sample_rmse = np.sqrt(np.mean((preds - targets) ** 2, axis=1))
    sample_psnr = 20 * np.log10(1.0 / (sample_rmse + 1e-8))

    return {
        "preds": preds,
        "targets": targets,
        "rmse": rmse,
        "mae": mae,
        "psnr": 20 * np.log10(1.0 / (rmse + 1e-8)),
        "sample_rmse": sample_rmse,
        "sample_psnr": sample_psnr,
    }


# ==================== 可视化 ====================
def plot_results(results_sim, results_real, wav, save_path):
    """绘制结果"""
    fig, axes = plt.subplots(2, 4, figsize=(16, 8))

    # 仿真测试集
    for i in range(4):
        ax = axes[0, i]
        idx = i * (len(results_sim["preds"]) // 4)
        ax.plot(wav, results_sim["targets"][idx], "b-", linewidth=2, label="GT")
        ax.plot(wav, results_sim["preds"][idx], "r--", linewidth=2, label="Pred")
        ax.set_xlabel("Wavelength (nm)")
        ax.set_ylabel("Reflectance")
        ax.set_title(f'Sim #{idx+1} (PSNR={results_sim["sample_psnr"][idx]:.1f}dB)')
        ax.legend()
        ax.grid(True)
        ax.set_ylim([0, 1])

    # 实测数据
    for i in range(4):
        ax = axes[1, i]
        idx = i * 6  # 0, 6, 12, 18
        if idx < len(results_real["preds"]):
            ax.plot(wav, results_real["targets"][idx], "b-", linewidth=2, label="GT")
            ax.plot(wav, results_real["preds"][idx], "r--", linewidth=2, label="Pred")
            ax.set_xlabel("Wavelength (nm)")
            ax.set_ylabel("Reflectance")
            ax.set_title(
                f'Real #{idx+1} (PSNR={results_real["sample_psnr"][idx]:.1f}dB)'
            )
            ax.legend()
            ax.grid(True)
            ax.set_ylim([0, 1])

    plt.suptitle(
        f'Sim PSNR={results_sim["psnr"]:.2f}dB, Real PSNR={results_real["psnr"]:.2f}dB',
        fontsize=14,
    )
    plt.tight_layout()
    plt.savefig(save_path, dpi=150)
    plt.close()


# ==================== 主函数 ====================
def main():
    # 配置
    config = {
        "data_path": "./dataset/fdm_e2e_global_norm.mat",
        "save_dir": "./checkpoints",
        "batch_size": 128,
        "lr": 1e-3,
        "weight_decay": 1e-3,
        "dropout": 0.5,
        "patience": 10,
        "max_epochs": 100,
        "input_length": 1000,
        "output_channels": 31,
    }

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

    print("=" * 60)
    print("FDM 端到端光谱重建训练")
    print("=" * 60)
    print(f"设备: {device}")
    print(f"数据: {config['data_path']}")
    print(f"Batch Size: {config['batch_size']}")
    print(f"Learning Rate: {config['lr']}")
    print("=" * 60)

    # 加载数据
    train_dataset = FDMDataset(config["data_path"], "train")
    val_dataset = FDMDataset(config["data_path"], "val")
    test_dataset = FDMDataset(config["data_path"], "test")
    real_dataset = RealDataset(config["data_path"])

    train_loader = DataLoader(
        train_dataset, batch_size=config["batch_size"], shuffle=True, num_workers=0
    )
    val_loader = DataLoader(
        val_dataset, batch_size=config["batch_size"], shuffle=False, num_workers=0
    )
    test_loader = DataLoader(
        test_dataset, batch_size=config["batch_size"], shuffle=False, num_workers=0
    )
    real_loader = DataLoader(real_dataset, batch_size=24, shuffle=False, num_workers=0)

    # 模型
    model = FDMNet(
        input_length=config["input_length"],
        output_channels=config["output_channels"],
        dropout=config["dropout"],
    ).to(device)

    print(f"模型参数量: {sum(p.numel() for p in model.parameters()):,}")

    # 优化器
    criterion = nn.MSELoss()
    optimizer = optim.Adam(
        model.parameters(), lr=config["lr"], weight_decay=config["weight_decay"]
    )
    scheduler = optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode="min", factor=0.5, patience=5
    )

    # 训练
    Path(config["save_dir"]).mkdir(exist_ok=True)
    best_val_loss = float("inf")
    patience_counter = 0

    print("\n" + "=" * 90)
    print(
        f"{'Epoch':>5} | {'Train Loss':>10} {'RMSE':>8} {'PSNR':>8} | {'Val Loss':>10} {'RMSE':>8} {'PSNR':>8} | {'LR':>9} | {'Time':>6}"
    )
    print("=" * 90)

    for epoch in range(1, config["max_epochs"] + 1):
        start_time = time.time()

        train_metrics = train_epoch(model, train_loader, criterion, optimizer, device)
        val_metrics = evaluate(model, val_loader, criterion, device)

        scheduler.step(val_metrics["loss"])

        elapsed = time.time() - start_time
        lr = optimizer.param_groups[0]["lr"]

        improved = val_metrics["loss"] < best_val_loss
        if improved:
            best_val_loss = val_metrics["loss"]
            patience_counter = 0
            torch.save(model.state_dict(), f"{config['save_dir']}/best_model.pth")
            marker = "*"
        else:
            patience_counter += 1
            marker = f'({patience_counter}/{config["patience"]})'

        print(
            f"{epoch:5d} | {train_metrics['loss']:10.6f} {train_metrics['rmse']:8.4f} {train_metrics['psnr']:6.2f}dB | "
            f"{val_metrics['loss']:10.6f} {val_metrics['rmse']:8.4f} {val_metrics['psnr']:6.2f}dB | "
            f"{lr:9.2e} | {elapsed:5.1f}s {marker}"
        )

        if patience_counter >= config["patience"]:
            print(f"\nEarly stopping at epoch {epoch}")
            break

    # 加载最佳模型评估
    print("\n" + "=" * 60)
    print("加载最佳模型进行评估...")
    model.load_state_dict(torch.load(f"{config['save_dir']}/best_model.pth"))

    test_metrics = evaluate(model, test_loader, criterion, device)
    print(f"测试集: RMSE={test_metrics['rmse']:.4f}, PSNR={test_metrics['psnr']:.2f}dB")

    # 详细评估
    results_sim = evaluate_detailed(model, test_loader, device)
    results_real = evaluate_detailed(model, real_loader, device)

    print(f"仿真测试: RMSE={results_sim['rmse']:.4f}, PSNR={results_sim['psnr']:.2f}dB")
    print(
        f"实测数据: RMSE={results_real['rmse']:.4f}, PSNR={results_real['psnr']:.2f}dB"
    )

    # 绘图
    wav = np.linspace(400, 700, 31)
    plot_results(results_sim, results_real, wav, f"{config['save_dir']}/results.png")
    print(f"结果已保存到 {config['save_dir']}/results.png")


if __name__ == "__main__":
    main()
